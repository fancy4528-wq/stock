# Copy to .env and fill in local values. Never commit .env.
# Verified against live sources as of 2026-09 (keep dates/versions current).

# Docker / PostgreSQL
PG_PASSWORD=change-me
POSTGRES_DB=quantagent
POSTGRES_USER=quantagent
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# SQLAlchemy URL (psycopg3). If omitted, built from POSTGRES_* / PG_PASSWORD.
DATABASE_URL=postgresql+psycopg://quantagent:change-me@127.0.0.1:5432/quantagent

# Docker / Redis
REDIS_PASSWORD=change-me

# Raw Parquet archive root (Collector output)
DATA_RAW_DIR=data/raw

# Collector rate limits (seconds between requests)
AKSHARE_RATE_LIMIT=0.5
BAOSTOCK_RATE_LIMIT=0.2
# Bypass Windows system proxy for collectors (set false if you need a working proxy).
# Do NOT name this *..._PROXY — urllib would treat it as a proxy URL.
COLLECTOR_DISABLE_SYSTEM_PROXY=true

# Optional data-source tokens (P0)
TUSHARE_TOKEN=

# Optional LLM (P2+). Empty → NullLLMClient (deterministic Reporter, $0).
# OpenAI-compatible Chat Completions (DeepSeek / OpenAI / etc.); see config/llm.yaml.
LLM_API_KEY=
# Optional override of tier base_url from config/llm.yaml
LLM_BASE_URL=
LLM_DEFAULT_TIER=medium

# RAG embedding (P2). hash = CI/default (no model download); fastembed = local model.
# Install optional extra first: uv sync --extra embedding
EMBEDDING_BACKEND=hash
# Must be a fastembed-supported 1024-d model (NOT BAAI/bge-large-zh — unsupported).
# Good default for Chinese: intfloat/multilingual-e5-large
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# First fastembed run downloads from HuggingFace; if timeout in CN:
# HF_ENDPOINT=https://hf-mirror.com

# P2a alerts (optional). Empty → LogNotifier (stdout only).
# Priority: PushPlus → WeCom → Telegram
# PushPlus: https://www.pushplus.plus/ 微信扫码 → 复制 token（推到微信）
PUSHPLUS_TOKEN=
# wechat | webhook | mail | ...（默认 wechat）
PUSHPLUS_CHANNEL=wechat
# 企业微信群机器人 Webhook（若客户端无「群机器人」入口可忽略）
WECOM_WEBHOOK_URL=
# Telegram (needs reachable api.telegram.org)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
